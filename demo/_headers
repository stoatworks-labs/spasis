/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://intake.stoatworks-labs.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# connect-src lists the intake origin, and that is not optional even though this
# demo never calls out on its own: the shared support footer carries a "Report a
# bug or send feedback" button that POSTs there. With a bare `connect-src 'self'`
# the report is refused — in PRODUCTION ONLY, because a local dev server does not
# apply this file at all, so it fails nowhere you would notice while working on
# it. Eighteen demos shipped that way once.
#
# media-src blob: is inherited from the shared kit, which makes an object URL for
# a dropped-in video. Spasis has no video input, so nothing here uses it.

/vendor/*
  Cache-Control: public, max-age=3600
